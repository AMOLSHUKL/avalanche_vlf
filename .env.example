# Runtime configuration via environment variables.
# All fusion parameters (thresholds, priors, caps, survival model) live in
# config/fusion_parameters.yaml and can be hot-swapped at runtime via
# PUT /api/config/fusion-parameters. Only these two are env-driven:

# Path to the fusion parameter file.
FUSION_CONFIG_PATH=config/fusion_parameters.yaml

# Uvicorn log verbosity: DEBUG, INFO (default), WARNING, ERROR.
LOG_LEVEL=INFO
